node_modules/
build/
dist/
coverage/
test-results/
playwright-report/
temp/
.DS_Store
*.log
.env*
!.env.example

# Husky 自動產生的 hook 腳本，由 `npm run prepare`（husky）重建。
# 內容隨 husky 版本與平台而異，追蹤只會製造無意義的合併衝突。
.husky/_/

# Local Database Caches
.cache/
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm
data/*.sqlite-journal
data/official-templates/output/
# Extracted ODT/PDF caches (rebuildable from the .odt/.pdf sources)
data/official-templates/files/*/

# Temporary Scratch & Patch Scripts
fix_*.py
fix_*.cjs
fix_*.sh
patch_*.py
patch_*.cjs
odt-probe.ts
tmp/

# Tool-local agent config (self-ignores its node_modules)
.opencode/
patch_*.sh
update_*.py
update_*.cjs
test_*.cjs
!scripts/maintenance/*

# AOCI agent host integration (machine-bound; do not commit)
opencode.json
opencode.json.backup.*
