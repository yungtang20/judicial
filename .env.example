# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Judicial OpenData API credentials (司法院資料開放平臺帳號密碼)
JUDICIAL_OPENDATA_ACCOUNT=
JUDICIAL_OPENDATA_PASSWORD=

# NEW_API_KEY: Optional custom LLM API key (API endpoint / proxy)
NEW_API_KEY=

# GOOGLE_GEMINI_BASE_URL: 專門用於客製化代理或自定義 API 端點 (例如 https://api.hcnsec.cn/v1beta)
GOOGLE_GEMINI_BASE_URL=

# Optional Taiwan Legal RAG retrieval for the triage source tabs.
# Disabled by default; only query text is sent to the configured provider.
TLR_ENABLED=false
TLR_BASE_URL=https://tlr.dr-legal.com.tw

# Optional OpenAI-compatible provider. Never commit a real key.
# Set AI_PROVIDER=hcnsec only after confirming the provider's API and privacy terms.
AI_PROVIDER=gemini
HCNSEC_API_KEY=
HCNSEC_BASE_URL=https://api.hcnsec.cn/v1
HCNSEC_MODEL=gpt-4o-mini
HCNSEC_TIMEOUT_MS=30000

