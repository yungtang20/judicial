# ==============================================================================
# Smart Legal Assistant - 環境變數設定指南 (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 伺服器與部署設定 (Server & Deployment)
# ------------------------------------------------------------------------------
# 監聽埠號 (預設為 3000，Cloud Run 等容器平台會自動指派 PORT 變數)
PORT=3000

# 應用程式對外基礎 URL (自動注入或自訂域名)
APP_URL="http://localhost:3000"

# Express 反向代理信任設定 (Reverse Proxy Trust)
# - "true" / 1: 信任上一層反向代理 (例如 Google Cloud Run, Nginx, ALB)
# - "false" / 0: 不信任代理 (直接暴露或本機開發)
TRUST_PROXY=1

# 內容安全政策 (Content-Security-Policy) 強制模式
# - "true" (正式環境標準安全配置): 強制啟用嚴格阻擋 CSP，攔截未經授權之跨站連線
# - "false" / CSP_REPORT_ONLY=true: 啟用 Report-Only 模式，僅在 Console 記錄違規警告不強制阻斷
CSP_ENFORCE=true

# API 身分認證與租戶安全 (Authentication & Multi-Tenant Isolation)
# - "true": 強制所有 API 請求必須攜帶有效之 Bearer Token 或 X-API-Key
# - "false" (預設): 允許沙盒免登入試用，未登入請求將被固定隔離於 sandbox-tenant 獨立租戶
REQUIRE_AUTH=false

# JWT 密碼學簽名密鑰 (至少 32 字元長度的隨機高熵字串，用於 HMAC-SHA256 簽名與驗證)
JWT_SECRET=

# 系統管理員與內部微服務專用 API Key (選填)
ADMIN_API_KEY=
SYSTEM_API_KEY=

# 審計日誌 SQLite 資料庫持久化路徑 (預設為 ./data/audit_logs.sqlite)
AUDIT_DB_PATH=./data/audit_logs.sqlite

# ------------------------------------------------------------------------------
# 2. AI 模型服務提供商 (AI Provider Configuration)
# ------------------------------------------------------------------------------
# 【提供商切換核心】
# AI_PROVIDER 可選值:
# - "gemini": 官方 Google Gemini API (預設，推薦)
# - "hcnsec": OpenAI 相容介面代理 (自訂端點)
AI_PROVIDER=gemini

# [選項 A] Google Gemini (當 AI_PROVIDER=gemini 時必要)
# 官方 Google Gemini API 金鑰 (請勿將金鑰提交至版本庫)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# (選填) 自訂 Gemini 代理端點。若需透過特定自建 Gateway 轉發時填寫，預設保留空白使用 Google 官方端點
GOOGLE_GEMINI_BASE_URL=

# [選項 B] OpenAI-Compatible / HCNSEC 提供商 (當 AI_PROVIDER=hcnsec 時必要)
# 僅在經過機構隱私與法遵評估後啟用第三方 OpenAI 相容代理
HCNSEC_API_KEY=
HCNSEC_BASE_URL=https://api.hcnsec.cn/v1
HCNSEC_MODEL=gpt-4o-mini
HCNSEC_TIMEOUT_MS=30000

# (選填) 備用自訂 API 金鑰
NEW_API_KEY=

# ------------------------------------------------------------------------------
# 3. 司法院資料整合服務 (Judicial OpenData & RAG)
# ------------------------------------------------------------------------------
# 是否啟用司法院裁判書 OpenData 檢索 (預設為 true，關閉則僅使用本機索引)
USE_OPENDATA=true

# 司法院 OpenData API 請求逾時時間 (毫秒，預設 3000ms)
OPENDATA_TIMEOUT_MS=3000

# 司法院裁判書 OpenData 帳號與密碼 (選填，若有專屬介接帳號可填寫)
JUDICIAL_OPENDATA_ACCOUNT=
JUDICIAL_OPENDATA_PASSWORD=

# (選填) 外部法律 RAG (Taiwan Legal RAG) 服務
# 預設 false，未啟用時系統會安全降級至本機結構化判決法規索引
TLR_ENABLED=false
TLR_BASE_URL=https://tlr.dr-legal.com.tw
