{
  "name": "smart-legal-assistant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run src/domain/case/caseLifecycle.e2e.test.ts",
    "test:official-sync": "node --import tsx --test scripts/sync-official-templates.test.mjs",
    "test:coverage": "vitest run --coverage",
    "test:eval": "vitest run src/lib/legalGovernance.test.ts",
    "test:ssrf": "node test-ssrf.cjs",
    "sync:official-templates": "tsx scripts/sync-official-templates.mjs",
    "inventory:official-template-fields": "tsx scripts/inventory-official-template-fields.mjs",
    "verify:official-templates": "tsx scripts/sync-official-templates.mjs --verify-only",
    "verify:official-mappings": "tsx scripts/verify-official-template-mappings.mjs",
    "preview:official-mapping": "tsx scripts/preview-official-template-mapping.mjs",
    "stress:official-source": "tsx scripts/stress-official-template-source.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.546.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "esbuild": "^0.25.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "6.4.3",
    "vitest": "^4.1.11"
  }
}
