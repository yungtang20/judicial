      "故意",
      "過失",
      "違反保護他人之法律",
      "車禍",
      "侵權"
    ]
  },
  {
    "id": "statute-civ-213",
    "type": "statute",
    "citation": "民法第213條",
    "name": "民法",
    "articleOrCaseNo": "第213條",
    "title": "損害賠償之方法回復原狀",
    "content": "負損害賠償責任者，除法律另有規定或契約另有訂定外，應回復他方損害發生前之原狀。因回復原狀而應給付金錢者，自損害發生時起，加給利息。第一項情形，債權人得請求支付回復原狀所必要之費用，以代回復原狀。",
    "authority": "立法院/法務部",
    "date": "1929-11-22",
    "sourceUrl": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=B0000001&flno=213",
    "keywords": [
      "回復原狀",
      "金錢賠償",
      "修復費用",
      "利息",
      "損害賠償方法"
    ]
  },
